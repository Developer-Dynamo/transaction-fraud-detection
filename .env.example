# Copier en .env pour documenter vos réglages (les scripts lisent les variables
# d'environnement ; avec Docker Compose, elles sont injectées par docker-compose.yml).

# --- Chemins ---
FRAUD_DATA_DIR=data
FRAUD_MODEL_DIR=models
FRAUD_HISTORY_CSV=data/sample/History.csv

# --- Services ---
FRAUD_SCORE_API_URL=http://localhost:8001/score
AGENT_API_URL=http://localhost:8001
DASHBOARD_PORT=8002
LOG_LEVEL=INFO

# --- Dashboard : en HTTPS uniquement ---
DASHBOARD_COOKIE_SECURE=false
DASHBOARD_SESSION_TTL_SECONDS=28800

# --- Scoring (optionnel) ---
# FRAUD_THRESHOLD=0.02
# FRAUD_ALLOW_MAX_SCORE=20
# FRAUD_BLOCK_MIN_SCORE=80

# --- Simulateur de flux (optionnel) ---
# FRAUD_SEED=42
# FRAUD_SIM_SPEED=1.0
# FRAUD_TX_PER_CARD_PER_DAY=2.0
